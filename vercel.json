{
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://3d.sangeetha.com/:path*",
      "permanent": false
    },
    {
      "source": "/p",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/product"
    },
    {
      "source": "/ar-experience/:path*",
      "destination": "/"
    },
    {
      "source": "/id/:path*",
      "destination": "/"
    },
    {
      "source": "/embed/:path*",
      "destination": "/"
    },
    {
      "source": "/showroom/:path+",
      "destination": "/showroom"
    },
    {
      "source": "/compare/:path+",
      "destination": "/compare"
    }
  ],
  "headers": [
    {
      "source": "/models/usdz/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/vnd.usdz+zip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/models/(.*).glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
